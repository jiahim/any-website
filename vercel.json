{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/site-feedback": false,
      "codex/site-feedback-smtp-diagnostics": false
    }
  },
  "functions": {
    "app/api/site-feedback/notify/route.ts": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "site-feedback-mail" }]
    }
  },
  "crons": [{ "path": "/api/site-feedback/recover", "schedule": "0 3 * * *" }]
}
