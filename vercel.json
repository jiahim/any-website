{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/stream-completion": false
    }
  },
  "functions": {
    "app/api/social-hot-words/refresh/route.ts": {
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    }
  },
  "schedules": {
    "social-hot-words": {
      "schedule": "*/30 * * * *",
      "function": "api/social-hot-words/refresh"
    }
  }
}
