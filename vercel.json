{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/stream-completion": false,
      "codex/restore-site-feedback": false
    }
  },
  "functions": {
    "app/api/social-hot-words/refresh/route.ts": {
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    },
    "app/api/site-feedback/notify/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "site-feedback-mail"
        }
      ]
    }
  },
  "schedules": {
    "social-hot-words": {
      "schedule": "*/30 * * * *",
      "function": "api/social-hot-words/refresh"
    }
  },
  "crons": [
    {
      "path": "/api/site-feedback/recover",
      "schedule": "0 3 * * *"
    }
  ]
}
